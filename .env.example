# Copy to .env for local non-Docker runs; docker-compose.yml sets these itself.
DATABASE_URL=postgresql+psycopg2://research:research@localhost:5432/researchdb
MAX_BUNDLE_ENTRIES=20
# A pending marker with no heartbeat for this long is presumed crashed and may
# be recovered by a retry. The default keeps the original 60s threshold.
IDEMPOTENCY_STALE_SECONDS=60
# How often an in-flight request refreshes its liveness heartbeat (must be
# well below IDEMPOTENCY_STALE_SECONDS so slow-but-alive requests never recover).
IDEMPOTENCY_HEARTBEAT_SECONDS=20
